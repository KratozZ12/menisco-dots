// Generado por los ajustes de Menisco (menisco-niri.py vidrio). Se reescribe al cambiarlos.

window-rule {
    background-effect {
        blur true
        xray true
        liquid-glass {
            mode "kwin-glass"
            refraction-strength 4.2
            power-factor 2.4
            refraction-bevel-intensity 16.6
            refraction-offset-strength 11.8
            edge-thickness 0.3
            fringing 0.95
            glow-weight 0.28
            edge-lighting 0.52
            saturation 1.3
        }
    }
}

layer-rule {
    match namespace="^dock$"
    geometry-corner-radius 22
    background-effect {
        blur true
        xray true
        liquid-glass {
            mode "kwin-glass"
            refraction-strength 4.2
            power-factor 2.4
            refraction-bevel-intensity 16.6
            refraction-offset-strength 11.8
            edge-thickness 0.3
            fringing 0.95
            glow-weight 0.28
            edge-lighting 0.52
            saturation 1.3
        }
    }
}
